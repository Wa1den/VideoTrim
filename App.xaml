<Application x:Class="VideoTrim.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ThemeMode="System">
    <Application.Resources>
        <SolidColorBrush x:Key="Fg" Color="{DynamicResource TextFillColorPrimary}" />
        <SolidColorBrush x:Key="FgDim" Color="{DynamicResource TextFillColorSecondary}" />
        <SolidColorBrush x:Key="Warn" Color="{DynamicResource SystemFillColorCaution}" />
        <SolidColorBrush x:Key="Panel" Color="{DynamicResource CardBackgroundFillColorDefault}" />
        <SolidColorBrush x:Key="PanelStroke" Color="{DynamicResource CardStrokeColorDefault}" />
        <SolidColorBrush x:Key="PanelSolid" Color="{DynamicResource SolidBackgroundFillColorBase}" />

        <FontFamily x:Key="Icons">Segoe Fluent Icons,Segoe MDL2 Assets</FontFamily>

        <CornerRadius x:Key="CardCorner">8</CornerRadius>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelStroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource CardCorner}" />
            <Setter Property="Padding" Value="16" />
        </Style>
    </Application.Resources>
</Application>
